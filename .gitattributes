*.mbtiles filter=lfs diff=lfs merge=lfs -text
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text

# Force LF line endings for the deployment config files this stack parses
# inside Linux containers. Without this, a Windows clone with Git's default
# core.autocrlf=true rewrites these to CRLF, and e.g. a CRLF uwsgi.ini
# ("socket = 0.0.0.0:5000\r") fails to bind at container startup.
* text=auto eol=lf
*.conf text eol=lf
*.ini  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.png  binary
*.PNG  binary
*.pbf  binary
