# RBT Docker Compose environment overrides.
#
# This file is optional: docker-compose.yaml has sane built-in defaults for
# everything below, so `docker compose up -d` works without an .env file at
# all. Copy this file to `.env` only if you want to change one of these
# values:
#
#   cp .env.example .env

# Address Docker publishes ports on.
#   0.0.0.0   - reachable from other devices on your network (default)
#   127.0.0.1 - this machine only; also avoids the Windows Defender
#               Firewall "allow network access" prompt on first
#               `docker compose up -d`
BIND_ADDR=0.0.0.0

# Host ports for nginx (the single entry point for all services) and for
# direct/backwards-compatible access to TileserverGL.
NGINX_PORT=8081
TILESERVER_PORT=8080

# uWSGI worker tuning for the mapproxy service. Keep UWSGI_PROCESSES at or
# below your host's CPU core count. These defaults assume the documented
# 8-core / 16GB minimum -- see mapproxy/config/uwsgi.ini for the matching
# limit-as/reload-on-rss memory ceilings, which you should adjust together
# with this value.
UWSGI_PROCESSES=4
UWSGI_THREADS=2

# Shared memory (/dev/shm) sizes. TileserverGL's MapLibre GL Native
# renderer and MapProxy's image stack both use shared memory for raster
# compositing; undersizing this causes rendering failures that are not
# always obvious from the logs.
TILESERVER_SHM_SIZE=2gb
MAPPROXY_SHM_SIZE=512mb
NGINX_SHM_SIZE=1gb
